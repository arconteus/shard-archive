    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.66.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.1"
  }
